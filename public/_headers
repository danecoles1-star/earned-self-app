# Earned Self — Cloudflare Pages response headers (public production).
# No Cloudflare Access: the app is public and member data is protected by
# Supabase sign-in and row-level security.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://vovmkiuxmtnedfosoxds.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Vite fingerprints everything in /assets, so it can be cached for a year.
# HTML keeps Cloudflare's default (always revalidate) so releases show up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Preview and branch deployments stay out of search results.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
